{
  "name": "yumi-app",
  "version": "1.0.0",
  "description": "YUMI — Jeu de plis multijoueur en temps réel",
  "scripts": {
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npx vite build",
    "build": "npm run build:server && npm run build:client",
    "start:server": "cd server && npm run start",
    "start:client": "cd client && npx vite --port 5173",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npx vite --port 5173"
  },
  "keywords": ["yumi", "jeu", "cartes", "multijoueur"],
  "author": "Cédric Martinez",
  "license": "ISC"
}
